Bootstrap: docker
From: ubuntu:22.04

%files
    marker.txt /git-marker.txt

%post
    mkdir -p /mnt/input /mnt/output /mnt/scripts

%runscript
    cat /git-marker.txt

    if [ -f /mnt/scripts/check.sh ]; then
        exec /bin/sh /mnt/scripts/check.sh "$@"
    fi

    echo "No external check.sh provided; running default behaviour."
    printf 'Arguments received: %s\n' "$#"
    for arg in "$@"; do
        printf '  %s\n' "$arg"
    done